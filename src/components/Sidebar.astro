---
import { profile } from '../data/profile';
---

<aside class="sidebar" data-sidebar>

  <div class="sidebar-info">

    <figure class="avatar-box">
      <img src={profile.avatar} alt={profile.name} width={profile.avatarWidth} />
    </figure>

    <div class="info-content">
      <h1 class="name" title={profile.name} style="font-size: 1.25rem; word-break: break-word;">{profile.name}</h1>

      <p class="title">{profile.title}</p>
    </div>

    <button class="info_more-btn" data-sidebar-btn>
      <span>Show Contacts</span>

      <ion-icon name="chevron-down"></ion-icon>
    </button>

  </div>

  <div class="sidebar-info_more">

    <div class="separator"></div>

    <ul class="contacts-list">
      {profile.contacts.map((contact) => (
        <li class="contact-item">

          <div class="icon-box">
            <ion-icon name={contact.icon}></ion-icon>
          </div>

          <div class="contact-info">
            <p class="contact-title">{contact.title}</p>

            {contact.kind === 'link' && <a href={contact.href} class="contact-link">{contact.value}</a>}
            {contact.kind === 'time' && <time datetime={contact.datetime}>{contact.value}</time>}
            {contact.kind === 'address' && <address>{contact.value}</address>}
          </div>

        </li>
      ))}
    </ul>

    <div class="separator"></div>

    <ul class="social-list">
      {profile.socials.map((social) => (
        <li class="social-item">
          <a href={social.href} class="social-link">
            <ion-icon name={social.icon}></ion-icon>
          </a>
        </li>
      ))}
    </ul>

  </div>

</aside>
