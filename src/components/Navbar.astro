---
import { navItems } from '../data/navigation';
---

<nav class="navbar">

  <ul class="navbar-list">
    {navItems.map((item, index) => (
      <li class="navbar-item">
        <button class:list={['navbar-link', { active: index === 0 }]} data-nav-link>{item.label}</button>
      </li>
    ))}
  </ul>

</nav>
